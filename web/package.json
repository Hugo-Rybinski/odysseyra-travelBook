{
  "name": "odysseyra-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA travel-book viewer — renders an Odysseyra TravelBook itinerary in the browser via Pyodide, with PDF export on the side.",
  "scripts": {
    "wheel": "bash scripts/build-wheel.sh",
    "check-wheel": "node scripts/check-wheel.mjs",
    "predev": "npm run check-wheel",
    "dev": "vite",
    "prebuild": "npm run check-wheel",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "pyodide": "0.26.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
